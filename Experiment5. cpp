#include <iostream>
using namespace std;

class Employee {
    float salary, bonus;

public:
    Employee() {
        salary = 0;
        bonus = 0;
    }

    Employee(float s, float b) {
        salary = s;
        bonus = b;
    }

    void display() {
        cout << "Total salary: " << salary + bonus << endl;
    }
};

int main() {
    float salary, bonus;

    cout << "Enter salary and bonus: ";
    cin >> salary >> bonus;

    Employee e1;
    Employee e2(salary, bonus);

    e1.display();
    e2.display();

    return 0;
}