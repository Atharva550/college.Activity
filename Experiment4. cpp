#include <iostream>
#include <string>
using namespace std;

class Product {
    string name;
    float price;
    int sales[12];

public:
    void accept() {
        cout << "Enter product name: ";
        getline(cin >> ws, name);

        cout << "Enter price per unit: ";
        cin >> price;

        cout << "Enter quantities sold in 12 months: ";
        for (int i = 0; i < 12; i++)
            cin >> sales[i];
    }

    void display() {
        int total = 0;

        for (int i = 0; i < 12; i++)
            total += sales[i];

        cout << "\nProduct: " << name << endl;
        cout << "Price: " << price << endl;
        cout << "Total quantity sold: " << total << endl;
        cout << "Total bill: " << total * price << endl;
    }
};

int main() {
    int n;

    cout << "Enter number of products: ";
    cin >> n;

    if (n <= 0)
        return 0;

    Product* p = new Product[n];

    for (int i = 0; i < n; i++)
        p[i].accept();

    for (int i = 0; i < n; i++)
        p[i].display();

    delete[] p;
    return 0;
}